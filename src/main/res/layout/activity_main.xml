<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/morandi_bg"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- 应用标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="30dp"
        android:text="真心话大冒险"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light" />

    <!-- 真心话卡片（上） -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="10dp"
        app:cardBackgroundColor="@color/morandi_primary"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardUseCompatPadding="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <!-- 真心话标题（放在原图标位置，改字体为cursive） -->
            <TextView
                android:id="@+id/truthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:text="真心话"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="cursive" />

            <!-- 已抽取题目情况 -->
            <TextView
                android:id="@+id/truthProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/truthTitle"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="60dp"
                android:text="0/100"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/truthButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="30dp"
                android:background="@drawable/rounded_button"
                android:text="开始抽取"
                android:textColor="@color/text_on_button"
                android:textSize="20sp" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- 大冒险卡片（下） -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="10dp"
        app:cardBackgroundColor="@color/morandi_secondary"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardUseCompatPadding="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <!-- 大冒险标题（放在原图标位置，改字体为cursive） -->
            <TextView
                android:id="@+id/dareTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:fontFamily="cursive"
                android:rotationY="1"
                android:text="大冒险"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- 已抽取题目情况 -->
            <TextView
                android:id="@+id/dareProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/dareTitle"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="60dp"
                android:text="0/100"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-light" />

            <!-- 2. 大冒险模块按钮颜色改为与大冒险模块一致 -->
            <Button
                android:id="@+id/dareButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="30dp"
                android:backgroundTint="@color/morandi_secondary"
                android:text="开始抽取"
                android:textColor="@color/white"
                android:textSize="20sp" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- 底部按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 3. 三个按钮使用新的莫兰迪色系颜色（morandi_tertiary） -->
        <Button
            android:id="@+id/resetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:backgroundTint="@color/morandi_tertiary"
            android:text="重置游戏"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/historyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:backgroundTint="@color/morandi_tertiary"
            android:text="历史记录"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/questionManagerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:backgroundTint="@color/morandi_tertiary"
            android:text="题库管理"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>