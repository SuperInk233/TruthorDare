<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础主题，取消标题栏 -->
    <style name="Theme.TruthOrDare" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/morandi_primary</item>
        <item name="colorPrimaryVariant">@color/morandi_dark</item>  <!-- 这里引用了morandi_dark -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- 强调色 -->
        <item name="colorSecondary">@color/morandi_secondary</item>
        <item name="colorSecondaryVariant">@color/morandi_accent</item>  <!-- 这里引用了morandi_accent -->
        <item name="colorOnSecondary">@color/white</item>

        <!-- 次要色调 -->
        <item name="colorSecondary">@color/morandi_secondary</item>
        <item name="colorSecondaryVariant">@color/morandi_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- 背景色 -->
        <item name="android:windowBackground">@color/morandi_bg</item>
        <item name="android:statusBarColor">@color/morandi_bg</item>

        <!-- 字体设置 -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- 去掉标题栏 -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>
</resources>